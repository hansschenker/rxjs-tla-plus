{
  "name": "rxjs-tla-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scoped TLA+ experiments and independent RxJS runtime evidence",
  "engines": { "node": ">=22" },
  "scripts": {
    "setup:tlc": "node scripts/setup-tlc.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:models": "node scripts/check-models.mjs",
    "verify": "npm run check:coverage && npm run verify:models && npm test",
    "check:coverage": "node scripts/check-coverage.mjs",
    "verify:mutation": "node scripts/check-mutation.mjs",
    "verify:protocol-mutation": "node scripts/check-protocol-mutation.mjs",
    "verify:tla-ts": "node experiments/03-tla-ts/compare.mjs"
  },
  "dependencies": { "rxjs": "7.8.2" }
}
